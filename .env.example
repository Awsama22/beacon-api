ENVIRONMENT=development
PORT=8040
LOG_LEVEL=INFO
# The Beacon website (Next.js dev server on port 5173); comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL from docker-compose.yml (container "natoor-postgres")
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=natoor
POSTGRES_DB=natoor
POSTGRES_PASSWORD_FILE=~/.config/natoor/postgres-password

# When set, the /ingestions endpoints need it in the X-Admin-Key header
ADMIN_API_KEY=

# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ (only for POST /ingestions/firms/area)
FIRMS_MAP_KEY=

WEATHER_CACHE_MINUTES=60

# Background fetch of FIRMS near-real-time fires every N minutes (0 turns it off),
# and how long near-real-time detections are kept
LIVE_REFRESH_MINUTES=60
NRT_RETENTION_DAYS=30
DOWNLOAD_TIMEOUT_SECONDS=300
